# halden-identity's public key, PEM encoded. Required: the service verifies
# every token against it and will not start without one. This is a public key,
# not a secret — the private half stays in halden-identity, which is why
# nothing here can mint a token.
HALDEN_INTERNAL_TOKEN_PUBLIC_KEY=CHANGE_ME

# Postgres holding the detections table.
# Injected in the cluster from the `halden-threat-detection-runtime` secret.
HALDEN_DATABASE_URL=postgresql+psycopg://CHANGE_ME:CHANGE_ME@localhost:5432/halden

# Directory backing the content-addressed artifact store.
HALDEN_ARTIFACT_DIR=/var/lib/halden/artifacts

# Ceiling on a single database statement, in milliseconds.
HALDEN_QUERY_TIMEOUT_MS=5000
