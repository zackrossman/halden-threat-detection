# halden-identity's public key, PEM encoded. Required: the service verifies
# every token against it and will not start without one. This is a public key,
# not a secret — the private half stays in halden-identity, which is why
# nothing here can mint a token.
HALDEN_INTERNAL_TOKEN_PUBLIC_KEY=CHANGE_ME

# Postgres holding the detections table.
# Injected in the cluster from the `halden-threat-detection-runtime` secret.
# sslmode is mandatory and must be `require` or stronger: detection records
# cross the cluster network, and libpq's default (`prefer`) downgrades to an
# unencrypted connection without saying so. The service refuses to start on a
# URL that permits plaintext.
HALDEN_DATABASE_URL=postgresql+psycopg://CHANGE_ME:CHANGE_ME@localhost:5432/halden?sslmode=require

# Directory backing the content-addressed artifact store.
HALDEN_ARTIFACT_DIR=/var/lib/halden/artifacts

# Ceiling on a single database statement, in milliseconds.
HALDEN_QUERY_TIMEOUT_MS=5000

# Where the service listens, and whether it does so over TLS.
#
# Traffic to this service crosses the cluster network carrying bearer tokens in
# the Authorization header, so it should be encrypted. Setting a cert and key
# moves the listener to TLS; both must be set together or the service refuses
# to start rather than quietly serving plaintext.
HALDEN_LISTEN_PORT=8000
HALDEN_TLS_CERT_FILE=
HALDEN_TLS_KEY_FILE=

# PEM bundle of the CA that signs client certificates. Setting it turns on
# mutual TLS: a caller without a certificate this CA signed is refused at the
# handshake, before any request is read. Requires the cert and key above.
HALDEN_TLS_CLIENT_CA_FILE=
